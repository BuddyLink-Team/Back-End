# ==========================================
# Application
# ==========================================

NODE_ENV=development

PORT=5000

CLIENT_URL=http://localhost:5173

# Business timezone for daily/monthly quotas
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Number of reverse proxies in front of the API (0 locally, usually 1 on Render/Railway/Nginx)
TRUST_PROXY=0



# ==========================================
# Database
# ==========================================

MONGODB_URI=mongodb+srv://buddylink_admin:<db_password>@cluster0.wg1nfcj.mongodb.net/buddylink_db


# ==========================================
# Authentication
# ==========================================

JWT_SECRET=<generated_jwt_secret>

JWT_REFRESH_SECRET=<generated_refresh_secret>

JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=7d


# ==========================================
# AI Provider
# ==========================================

AI_PROVIDER=gemini

GEMINI_API_KEY=<your_gemini_api_key>


# ==========================================
# Payment
# ==========================================

PAYOS_CLIENT_ID=<your_payos_client_id>

PAYOS_API_KEY=<your_payos_api_key>

PAYOS_CHECKSUM_KEY=<your_payos_checksum_key>

PAYOS_RETURN_URL=http://localhost:5173/payment/success

PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel


# ==========================================
# Google Maps / Places
# ==========================================

# OpenStreetMap Overpass (nearby places, free, no key). Set OVERPASS_ENABLED=false to use the cache only
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_ENABLED=true
# Sync the places around a parent in the background when their area is not cached yet
PLACES_AUTO_SYNC=true


# ==========================================
# Email
# ==========================================

SMTP_HOST=<your_smtp_host>

SMTP_PORT=587

SMTP_USER=<your_smtp_user>

SMTP_PASSWORD=<your_smtp_password>

EMAIL_FROM=<your_sender_email>

# Optional: send through the Brevo HTTP API instead of SMTP (for hosts that block SMTP ports).
# EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=<your_brevo_api_key>

# ==========================================
# Google
# ==========================================

GOOGLE_CLIENT_ID=<your_google_client_id>

# ==========================================
# Storage
# ==========================================

STORAGE_PROVIDER=<your_storage_provider>

STORAGE_BUCKET=<your_storage_bucket>

STORAGE_ACCESS_KEY=<your_storage_access_key>

STORAGE_SECRET_KEY=<your_storage_secret_key>