    {
      "name": "🔍 Discovery - GET Profiles",
      "item": [
        {
          "name": "GET Discovery - Default (parent location)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{parent_a_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/discovery",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "discovery"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success = true', () => pm.expect(res.success).to.eql(true));",
                  "pm.test('Has profiles array', () => { pm.expect(res.data.profiles).to.be.an('array'); console.log('📋 Found', res.data.profiles.length, 'profiles'); });",
                  "pm.test('Has meta with remainingViews', () => { pm.expect(res.data.meta).to.have.property('remainingViews'); pm.expect(res.data.meta).to.have.property('isPremium'); console.log('📊 Remaining:', res.data.meta.remainingViews, '| Premium:', res.data.meta.isPremium); });",
                  "",
                  "pm.test('Profile shape matches FE contract', () => {",
                  "  if (res.data.profiles.length > 0) {",
                  "    const p = res.data.profiles[0];",
                  "    pm.expect(p).to.have.all.keys('childId','parentId','displayName','age','gender','interests','favoriteActivities','personality','parent','matchScore','distanceKm','matchedInterestsCount');",
                  "    pm.expect(p.parent).to.have.all.keys('fullName','avatarUrl','bio','area','city','isVerifiedParent','preferences');",
                  "    console.log('🎯 Top:', p.displayName, '| Score:', p.matchScore, '| Dist:', p.distanceKm+'km');",
                  "  }",
                  "});",
                  "",
                  "pm.test('Sorted by matchScore DESC', () => {",
                  "  const profiles = res.data.profiles;",
                  "  for (let i = 1; i < profiles.length; i++) pm.expect(profiles[i-1].matchScore).to.be.at.least(profiles[i].matchScore);",
                  "});",
                  "",
                  "pm.test('No self-children', () => {",
                  "  const myId = pm.collectionVariables.get('parent_a_id');",
                  "  res.data.profiles.forEach(p => pm.expect(p.parentId).to.not.eql(myId));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
