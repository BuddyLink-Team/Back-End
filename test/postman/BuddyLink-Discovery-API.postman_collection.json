{
  "info": {
    "name": "BuddyLink - Discovery API (BUD-13)",
    "_postman_id": "bud-13-discovery-collection",
    "description": "Test collection for Discovery & Smart Matching endpoints.\n\n## Setup Flow:\n1. Run '1. Register Parent A' → auto-saves token\n2. Run '2. Get Parent A Profile' → saves parentId\n3. Run '3. Update Parent A Location' → sets geo coordinates\n4. Run '4. Create Child for Parent A' → creates child profile\n5. Run '5-8. Setup Parent B' → same for nearby parent\n6. Run Discovery & Swipe tests\n\n## Variables:\n- {{base_url}} = http://localhost:5000/api/v1\n- Tokens and IDs are auto-saved between requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "parent_a_token",
      "value": ""
    },
    {
      "key": "parent_b_token",
      "value": ""
    },
    {
      "key": "parent_a_id",
      "value": ""
    },
    {
      "key": "parent_b_id",
      "value": ""
    },
    {
      "key": "child_a_id",
      "value": ""
    },
    {
      "key": "child_b_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "🔐 Auth & Setup",
      "item": [
        {
          "name": "1. Register Parent A (Searcher)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Parent A - Discovery Test\",\n  \"email\": \"discovery-parent-a@test.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Register Parent A - Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Success = true', () => pm.expect(res.success).to.eql(true));",
                  "if (res.data?.tokens) { pm.collectionVariables.set('parent_a_token', res.data.tokens.accessToken); console.log('✅ Parent A token saved'); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Get Parent A Profile & ID",
