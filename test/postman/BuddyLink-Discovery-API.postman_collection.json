                  "pm.test('CHILD_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('CHILD_NOT_FOUND'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Swipe No Auth (401) 🔒",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.cookies.clear();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "console.log('🔒 Unauthenticated swipe blocked');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetChildId\": \"{{child_b_id}}\",\n  \"isLike\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/discovery/swipe",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "discovery",
                "swipe"
              ]
            }
          }
        },
        {
          "name": "Verify Swiped Excluded from Discovery",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{parent_a_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/discovery",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "discovery"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Swiped child excluded', () => {",
                  "  const childBId = pm.collectionVariables.get('child_b_id');",
                  "  const found = res.data.profiles.find(p => p.childId === childBId);",
                  "  pm.expect(found).to.be.undefined;",
                  "  console.log('✅ Child B excluded after swipe');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}